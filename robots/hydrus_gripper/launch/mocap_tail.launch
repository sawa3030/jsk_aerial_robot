<?xml version="1.0"?>
<launch>
    <!-- Joint 0 -->
    <group ns="joint0">
        <include file="$(find aerial_robot_base)/launch/external_module/mocap.launch">
            <arg name="robot_id" value="2" />
        </include>
    </group>

    <!-- Joint 4 -->
    <group ns="joint4">
        <include file="$(find aerial_robot_base)/launch/external_module/mocap.launch">
            <arg name="robot_id" value="6" />
        </include>
    </group>
</launch>